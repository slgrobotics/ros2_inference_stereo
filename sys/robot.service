# /etc/systemd/system/robot.service
# see https://github.com/slgrobotics/ros2_inference_stereo/blob/main/README.md#create-a-linux-service-for-on-boot-autostart
[Unit]
Description=ros2_inference_stereo
StartLimitIntervalSec=60
StartLimitBurst=5

[Service]
Type=simple
User=ros
Group=ros
WorkingDirectory=/home/ros/launch
ExecStart=/home/ros/launch/bootup_launch.sh
Restart=always

[Install]
WantedBy=multi-user.target
